# Example env for MemoryBox monolith (D7 — host-portable)

# Copy to a gitignored file. Do not commit secrets.
# Dev desktop = development. P1 runtime host = app + PG + Qdrant + Ollama (where practical).
# Media host = Immich/Plex/libraries via provider env — do not move media libs onto the app host.
# Same Git tree; swap values per machine.

# Set explicitly on the P1 runtime host (do not rely on ALLOW_DEV_DEFAULTS there):
MEMORYBOX_DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/memorybox
MEMORYBOX_HOST=0.0.0.0
MEMORYBOX_PORT=8790
MEMORYBOX_QDRANT_URL=http://QDRANT_HOST:6333
MEMORYBOX_QDRANT_COLLECTION=memorybox_evidence
MEMORYBOX_OLLAMA_BASE_URL=http://OLLAMA_HOST:11434
MEMORYBOX_OLLAMA_CHAT_MODEL=llama3.2
MEMORYBOX_OLLAMA_EMBED_MODEL=nomic-embed-text

# Desktop prove only (never for P1 runtime deploy):
# MEMORYBOX_ALLOW_DEV_DEFAULTS=1
# MEMORYBOX_QDRANT_URL=:memory:

# Optional real-data smoke (paths via config only; never commit family content):
# MEMORYBOX_SMOKE_MBOX_URI=/path/to/small.mbox
# MEMORYBOX_SMOKE_ICS_URI=/path/to/small.ics

# Immich / media providers: host-local gitignored immich.env (see immich.env.example)
