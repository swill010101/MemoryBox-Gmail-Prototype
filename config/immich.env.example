# Copy to config/immich.env (gitignored) and fill the API key.
# Create key in Immich UI: Account → API Keys
# Required: asset.read
# Recommended: album.read, person.read
# Optional for API thumbs: asset.view (else filesystem fallback is used)
# Optional for Status "Photos indexed" totals: server statistics and/or search.statistics
#   (Status also falls back to GET /timeline/buckets with asset.read when statistics is denied)

IMMICH_BASE_URL=http://192.168.4.30:2283/api
IMMICH_API_KEY=REPLACE_WITH_READ_ONLY_API_KEY

# Optional filesystem fallback for inline previews (key never sent to browser):
IMMICH_THUMBS_PATH=\\media-server\P\Immich\library\thumbs

# Data volumes stay on media-server (do not copy binaries):
# \\media-server\P\Immich\library
