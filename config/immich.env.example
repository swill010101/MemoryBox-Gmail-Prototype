# FlightSim Immich (same box as MemoryBox). Do not point this at media-server.
# Copy to gitignored config/immich.env and set the API key from Immich → Account → API Keys.
# startmb.ps1 sets MEMORYBOX_IMMICH_ENV to this file when present.

IMMICH_BASE_URL=http://127.0.0.1:2283/api
IMMICH_API_KEY=REPLACE_WITH_READ_ONLY_API_KEY

# Local Immich thumbs folder on FlightSim disk (no UNC, no API hit per card).
# Find it: docker inspect immich_server (UPLOAD_LOCATION) → …\thumbs
# IMMICH_THUMBS_PATH=C:\immich\library\thumbs

# Leave off unless thumbs path is missing. API thumbs can knock Immich over.
# IMMICH_THUMBS_API=1
