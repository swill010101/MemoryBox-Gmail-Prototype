# Derived / private runtime data (never sync via git)
working/
attachments/
database/
indexes/
exports/
backup/
logs/

# Local SQLite / runtime DBs anywhere in the tree
*.sqlite
*.sqlite3
*.db
!**/schema*.sql

# Local Postgres data dir (dev cluster)
.pgdata/

# Archive originals — LAN/robocopy only (see docs/GIT_SYNC.md). Never push zip/mbox/media.
archive/**
!archive/.gitkeep
!archive/checksums/
!archive/checksums/**

# HVRT sample media and local processing outputs (multi-GB)
hvrt/sample/**
!hvrt/sample/.gitkeep
!hvrt/sample/README.md
hvrt/gallery/**
!hvrt/gallery/.gitkeep
hvrt/database/
hvrt/.venv/

# Common large media (defense in depth)
*.zip
*.mbox
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.mkv
*.wmv
*.m4v

# Credentials / secrets
*.env
config/immich.env
config/secrets.json
config/local.json
config/marvin_capture.json
config/gmail_credentials.json
config/gmail_token.json

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Node / frontend build
node_modules/
application/**/dist/
application/**/build/

# Editors
.vscode/
.idea/

# Operating system
Thumbs.db
.DS_Store
Desktop.ini
